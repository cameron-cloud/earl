{
  "name": "earl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/art.mjs build --quiet",
    "dev": "vite",
    "prebuild": "node scripts/art.mjs build --quiet",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "npm run lint:eslint && npm run lint:format && npm run check:dashes",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "pretypecheck": "node scripts/art.mjs build --quiet",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:dashes": "node scripts/check-dashes.mjs",
    "capture:v1-fling": "node scripts/capture-v1-fling.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:selftest": "node --test scripts/bump-version.selftest.mjs",
    "art:import": "node scripts/art.mjs import",
    "art:build": "node scripts/art.mjs build",
    "art:check": "node scripts/art.mjs check",
    "art:status": "node scripts/art.mjs status",
    "art:templates": "node scripts/art.mjs templates",
    "art:shots": "node scripts/art.mjs shots",
    "sim": "node -e \"console.error('sim: not implemented until M1.5'); process.exit(1)\"",
    "sandbox": "node -e \"console.error('sandbox: not implemented until M1.S'); process.exit(1)\"",
    "docs:anim": "node -e \"console.error('docs:anim: not implemented until M1.4'); process.exit(1)\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.2"
  }
}
